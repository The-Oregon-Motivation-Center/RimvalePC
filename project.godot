; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Rimvale"
config/description="Rimvale - Tactical RPG"
config/version="2.0"
run/main_scene="res://scenes/title/title_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RimvaleAPI="*res://autoload/rimvale_engine_singleton.gd"
GameState="*res://autoload/game_state.gd"
MagicItemData="*res://autoload/magic_item_data.gd"
StoryBriefings="*res://autoload/story_briefings.gd"
VehicleData="*res://autoload/vehicle_data.gd"
RimvaleColors="*res://autoload/rimvale_colors.gd"
RimvaleUtils="*res://autoload/rimvale_utils.gd"
CharacterModelBuilder="*res://autoload/character_model_builder.gd"
EnemyArchetype="*res://autoload/enemy_archetype.gd"
AudioManager="*res://autoload/audio_manager.gd"
Settings="*res://autoload/settings_manager.gd"
InputManager="*res://autoload/input_manager.gd"
SteamIntegration="*res://autoload/steam_integration.gd"
BattleSystem="*res://autoload/battle_system.gd"
Conquest="*res://autoload/conquest.gd"
DebugMonitor="*res://scenes/test/debug_monitor.gd"

[display]

window/size/v