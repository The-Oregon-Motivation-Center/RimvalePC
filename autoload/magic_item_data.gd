## Returns the rarity string for an item. Falls back to "Common" if unknown.
func rarity_of(item_name: String) -> String:
	if ALL_MAGIC_ITEMS.has(item_name):
		return str(ALL_MAGIC_ITEMS[item_name].get("rarity", "Common"))
	return "Common"


## Returns the description for an item, or empty string if unknown.
func description_of(item_name: String) -> String:
	if ALL_MAGIC_ITEMS.has(item_name):
		return str(ALL_MAGIC_ITEMS[item_name].get("desc", ""))
	return ""


## Returns the effect dict for an item (empty dict if no effects).
func effects_of(item_name: String) -> Dictionary:
	if ALL_MAGIC_ITEMS.has(item_name):
		return Dictionary(ALL_MAGIC_ITEMS[item_name].get("effects", {}))
	return {}


## All magic-item names as a sorted PackedStringArray.
func all_names() -> PackedStringArray:
	var names: Array = ALL_MAGIC_ITEMS.keys()
	names.sort()
	return PackedStringArray(names)
