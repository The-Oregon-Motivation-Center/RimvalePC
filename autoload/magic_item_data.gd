# ── Helpers ────────────────────────────────────────────────────────────────────

## Rarity string for an item, or "" if unknown.
func rarity_of(item_name: String) -> String:
	if not ALL_MAGIC_ITEMS.has(item_name): return ""
	return str(ALL_MAGIC_ITEMS[item_name].get("rarity", ""))

## GMG description for an item, or "" if unknown.
func description_of(item_name: String) -> String:
	if not ALL_MAGIC_ITEMS.has(item_name): return ""
	return str(ALL_MAGIC_ITEMS[item_name].get("desc", ""))

## Effects dict for an item, or {} if unknown. Note: this is the raw static
## effects — for Apex tier-aware merging, use the engine's
## _resolve_effects_for_handle().
func effects_of(item_name: String) -> Dictionary:
	if not ALL_MAGIC_ITEMS.has(item_name): return {}
	return ALL_MAGIC_ITEMS[item_name].get("effects", {})

## All magic-item names sorted alphabetically.
func all_names() -> PackedStringArray:
	var names: Array = ALL_MAGIC_ITEMS.keys()
	names.sort()
	return PackedStringArray(names)